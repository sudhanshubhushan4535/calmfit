# Copy to .env and adjust. Local dev matches docker-compose.yml (host port 5434).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5434/calmfit?sslmode=disable
# OAuth 2.0 Web client ID from Google Cloud Console (Authorized JS origins: http://localhost, http://localhost:8080)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Separate DB for DB-backed tests; create and migrate it with `make test-db`
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5434/calmfit_test?sslmode=disable
# Product settings (plate-check weights, timezone); defaults to config/app.json when unset
APP_CONFIG=config/app.json
# Kafka on the compose broker (`make kafka-up`); the host listener is 9094
KAFKA_BROKERS=localhost:9094
# Broker for Kafka-backed tests; each test creates and deletes its own topics
TEST_KAFKA_BROKERS=localhost:9094
