{
  "uid": "calmfit",
  "title": "CalmFit",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "calmfit"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "API up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"api\"}",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "5xx rate (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(calmfit_http_request_duration_seconds_count{code=\"5xx\"}[5m])) / clamp_min(sum(rate(calmfit_http_request_duration_seconds_count[5m])), 1e-9)",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Consumer lag",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(sum by (instance) (calmfit_kafka_consumer_lag))",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "DLQ records",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(calmfit_kafka_dlq_records)",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Requests/s by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(calmfit_http_request_duration_seconds_count[1m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx share)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(calmfit_http_request_duration_seconds_count{code=\"5xx\"}[1m])) / clamp_min(sum(rate(calmfit_http_request_duration_seconds_count[1m])), 1e-9)",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "p95 latency by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(calmfit_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "p99 latency by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (route, le) (rate(calmfit_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag (calmfit-stats)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (partition) (calmfit_kafka_consumer_lag)",
          "legendFormat": "p{{partition}}",
          "refId": "A"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Outbox backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "calmfit_outbox_unpublished",
          "legendFormat": "unpublished rows",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "calmfit_outbox_oldest_unpublished_seconds",
          "legendFormat": "oldest age (s)",
          "refId": "B"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Worker events/s by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(calmfit_worker_events_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "DLQ records",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(calmfit_kafka_dlq_records)",
          "legendFormat": "dlq",
          "refId": "A"
        }
      ],
      "id": 12
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}