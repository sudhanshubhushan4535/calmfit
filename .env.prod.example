# Production settings for docker-compose.prod.yml. Copy to .env.prod on the VM (chmod 600); never
# commit .env.prod. Used as: docker compose -f docker-compose.prod.yml --env-file .env.prod -p calmfit ...
# APP_ENV=production is fixed in the compose file, so TEST_AUTH can never be on (D39).

# Image tag to run (make images IMAGE_TAG=...); default "latest"
IMAGE_TAG=

# Public hostname: nginx server_name, the certificate path, and the Google sign-in origin
DOMAIN=calmfit.example.com
# http until the first certificate exists, then https (D-E)
NGINX_MODE=http

# Postgres password for user calmfit (long random string)
POSTGRES_PASSWORD=

# Google sign-in: OAuth 2.0 Web client ID. In Google Cloud Console add https://$DOMAIN to
# "Authorized JavaScript origins" (sign-in fails on any origin not listed there).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Web Push reminders (D47): `make vapid-keys` prints a pair. Empty public key = reminders off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Voice logging LLM; only needed if voice.enabled is true in config/app.json (off by default)
ANTHROPIC_API_KEY=

# Grafana admin password (profile obs; UI on 127.0.0.1:3001, reach it with an SSH tunnel)
GRAFANA_ADMIN_PASSWORD=

# Nightly backups (scripts/backup-nightly.sh): where dumps go on the VM, and how many days to keep
BACKUP_DIR=/var/backups/calmfit
BACKUP_KEEP_DAYS=7
